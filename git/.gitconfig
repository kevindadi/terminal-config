[user]
	name = kevin
	email = zhangkw@tongji.edu.cn

[core]
	quotepath = false
	editor = vim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = gruvbox-dark
	features = decorations

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[color]
	ui = auto

[column]
	ui = auto

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[init]
	defaultBranch = main

[alias]
	# 状态 / 差异
	s = status -sb
	d = diff
	dc = diff --cached
	ds = diff --stat
	# 日志
	l = log --oneline --graph --decorate
	la = log --oneline --graph --decorate --all
	lp = log --patch
	last = show --stat HEAD
	who = shortlog -sn --no-merges
	# 提交 / 分支
	c = commit
	ca = commit --amend
	co = checkout
	sw = switch
	b = branch -a
	bd = branch -d
	f = fetch --all --prune
	p = push
	pl = pull --rebase
	# 撤销 / 暂存
	r = restore
	rs = restore --staged
	st = stash
	stl = stash list
	stp = stash pop
	cl = clean -fd
